{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension (examples/retail)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../../examples/retail"],
      "env": { "CADASTRE_SERVER": "${workspaceFolder}/../../compiler/target/debug/cadastre" },
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
