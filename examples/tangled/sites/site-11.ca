site site-11 {
  address_plan: [
    10.1.128.0/20,
    10.1.128.0/27,
    10.1.144.32/28,
    10.1.146.0/24,
    10.1.148.0/24,
    10.1.149.0/24,
    10.1.150.0/24,
    10.1.156.0/24,
    10.1.160.0/25,
    10.1.240.0/21
  ]
  hosting: colocation
  operator: team-06

  switch sw-14 {
    interface if-006
    interface if-007
    interface internet { peer: rtr-01.if-002, bandwidth: "500 Mbps" }
    interface if-008   { peer: fw-08.wan }
  }
  firewall fw-08 {
    model: "FortiGate 1800F"
    interface if-009
    interface wan
    interface lan { peer: sw-15.if-008 }
  }
  switch sw-15 {
    interface te2-0-1
    interface te2-0-2
    interface if-008
    interface if-010 { peer: fw-09.if-013 }
  }
  firewall fw-09 {
    model: "Check Point"
    interface if-011
    interface if-012
    interface if-013
    interface if-014 { peer: sw-16.if-010 }
  }
  switch sw-16 {
    model: "Catalyst 9300, IOS-XE 17.3.4"
    interface te2-0-1
    interface te2-0-2
    interface te1-1-4 { vlan: 1167, peer: rtr-03.if-002, bandwidth: "10 Gbps" }
    interface if-010
    interface team-08 { peer: rtr-12.lan }
    interface if-015  { peer: fw-05.if-002 }
  }

  device dev-06
  device dev-07
  device dev-08
  proxy rp-02
  router rtr-12 {
    operator: team-08
    interface lan { subnet: net-54, ip: 10.1.128.13 }
  }

  cluster clu-08 { platform: vmware }

  network zone-03 {
    subnet net-39 {
      cidr: 10.1.128.160/27
      vlan: 2484
      stretched_to: site-09

      virtual server srv-093 {
        ip: 10.1.128.172
        on: clu-08
        vcpu: 4
        ram: "8 Go"
        disk_size: "110 Go"
        os: "Windows Server 2016 or later"
        hypervisor: vmware
      }
    }

    subnet net-40 {
      cidr: 10.1.128.128/27
      vlan: 2483
      stretched_to: site-09

      virtual server srv-094 {
        ip: 10.1.128.150
        on: clu-08
        os: "Windows Server 2019"
        vcpu: 2
        ram: "4 Go"
        disk_size: "80 Go"
        hypervisor: vmware
