      {"index_key": 1, "attributes": {"id": "subnet-priv-b", "vpc_id": "vpc-0a1b", "cidr_block": "10.0.3.0/24", "availability_zone": "eu-west-3b", "tags": {"Name": "private-b"}}}]},
